# Copy this file to ".env" (same folder) and fill in the values.
# NEVER commit ".env" and NEVER put a wallet private key in it.

# SQLite database file (relative to the prisma/ folder)
DATABASE_URL="file:./dev.db"

# Port for the API
PORT=3001

# Secret used to sign login tokens. Use 32+ random characters.
# Generate one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL of the React app (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- Blockchain (fill these after you deploy the contract in Remix) ---
# Read-only Sepolia RPC URL from Alchemy / Infura (used only to verify receipts)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Address of the deployed EcoChainRewards contract
CONTRACT_ADDRESS=0x0dCA6e8bBb68DE7798baE6630a6E82c317368C79
CHAIN_ID=11155111
EXPLORER_BASE_URL=https://sepolia.etherscan.io
