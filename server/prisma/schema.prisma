// EcoChain database schema (SQLite for local development).
// Enum-like values are stored as validated strings (SQLite has no native enums).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  displayName   String // shown on the public leaderboard instead of the real name
  email         String   @unique
  passwordHash  String
  role          String   @default("CITIZEN") // CITIZEN | ADMIN
  walletAddress String?  @unique
  accountStatus String   @default("ACTIVE") // ACTIVE | SUSPENDED
  isDemo        Boolean  @default(false) // true for seeded demonstration accounts
  createdAt     DateTime @default(now())

  submissions   RecyclingSubmission[]
  verifications Verification[]
  rewards       Reward[]
  notifications Notification[]

  @@index([role])
}

model RecyclingSubmission {
  id                 String   @id @default(cuid())
  citizenId          String
  wasteCategory      String // PLASTIC | PAPER | GLASS | METAL
  quantityKg         Float
  collectionLocation String
  recyclingDate      DateTime
  evidenceImagePath  String?
  status             String   @default("PENDING") // PENDING | APPROVED | REJECTED | REWARD_PROCESSING | REWARDED
  rejectionReason    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  citizen      User          @relation(fields: [citizenId], references: [id])
  verification Verification?
  reward       Reward?

  @@index([citizenId, status])
  @@index([status, createdAt])
}

model Verification {
  id           String   @id @default(cuid())
  submissionId String   @unique // exactly one decision per submission
  adminId      String
  decision     String // APPROVED | REJECTED
  comments     String?
  verifiedAt   DateTime @default(now())

  submission RecyclingSubmission @relation(fields: [submissionId], references: [id])
  admin      User                @relation(fields: [adminId], references: [id])
}

model Reward {
  id                String   @id @default(cuid())
  citizenId         String
  submissionId      String   @unique // database-level duplicate-reward protection
  tokenAmount       Float
  transactionHash   String?  @unique
  transactionStatus String   @default("PROCESSING") // PROCESSING | CONFIRMED | FAILED
  failureReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  citizen    User                @relation(fields: [citizenId], references: [id])
  submission RecyclingSubmission @relation(fields: [submissionId], references: [id])

  @@index([citizenId, createdAt])
  @@index([transactionStatus])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
